# Neon Database Connection Strings
DATABASE_URL="postgresql://user:password@ep-xxxxx.neon.tech/neondb"
DATABASE_URL_POOLING="postgresql://user:password@ep-xxxxx-pooler.neon.tech/neondb"

# Application Settings
NEXT_PUBLIC_SITE_URL="https://www.andrxwliu.me"
NODE_ENV="development"

# Admin Settings (optional)
ADMIN_PASSWORD_HASH="bcrypt-hash-here"
NEXTAUTH_SECRET="your-secret-here"

# Spotify now playing (server only; enable user-read-currently-playing and user-read-recently-played)
# Create an app at https://developer.spotify.com/dashboard.
# Local redirect URI to register exactly: http://127.0.0.1:8888/callback
# Then add the client values below and run npm run spotify:auth.
# Vercel only needs CLIENT_ID, CLIENT_SECRET, and REFRESH_TOKEN for the current refresh-token flow.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
SPOTIFY_REDIRECT_URI="http://127.0.0.1:8888/callback"
